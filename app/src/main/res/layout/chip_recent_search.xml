<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/recent_search_chip_bg"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvChipText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search term"
        android:textColor="@color/logo_dark_blue"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/ivChipClose"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_close_small"
        android:tint="@color/logo_gold"
        android:layout_marginStart="8dp"
        android:padding="2dp" />

</LinearLayout>