<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.profile.ProfileFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="15dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_margin="10dp"
                        app:cardCornerRadius="100dp">

                        <ImageView
                            android:id="@+id/profileImg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="TODO"
                            android:scaleType="fitCenter"
                            android:src="@drawable/baseline_account_circle_24" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/profileUserName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:gravity="center_horizontal"
                        android:text="Username"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/profileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:gravity="center_horizontal"
                        android:text="username123@gmail.com"
                        android:textSize="20sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textView36"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10sp"
                android:text="Account Setting"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10sp"
                    app:cardBackgroundColor="@color/logo_blue"
                    app:cardCornerRadius="10dp">

                    <Button
                        android:id="@+id/profileOrderBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10sp"
                        android:backgroundTint="@color/logo_white"
                        android:gravity="start"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="20dp"
                        android:text="My Order"
                        android:textColor="@color/black"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_order"
                        app:iconGravity="textStart"
                        app:iconSize="20dp"
                        app:iconTint="@color/black" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10sp"
                    app:cardBackgroundColor="@color/logo_blue"
                    app:cardCornerRadius="10dp">

                    <Button
                        android:id="@+id/profileCartBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10sp"
                        android:backgroundTint="@color/logo_white"
                        android:gravity="start"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="20dp"
                        android:text="My Cart"
                        android:textColor="@color/black"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_cart"
                        app:iconGravity="textStart"
                        app:iconSize="20dp"
                        app:iconTint="@color/black" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10sp"
                    app:cardBackgroundColor="@color/logo_blue"
                    app:cardCornerRadius="10dp">

                    <Button
                        android:id="@+id/profileManageAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10sp"
                        android:backgroundTint="@color/logo_white"
                        android:gravity="start"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="20dp"
                        android:text="Manage Address"
                        android:textColor="@color/black"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_address"
                        app:iconGravity="textStart"
                        app:iconSize="20sp"
                        app:iconTint="@color/black" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10sp"
                    app:cardBackgroundColor="@color/logo_blue"
                    app:cardCornerRadius="10dp">

                    <Button
                        android:id="@+id/profileSettingBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10sp"
                        android:backgroundTint="@color/logo_white"
                        android:gravity="start"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="20dp"
                        android:text="App Setting"
                        android:textColor="@color/black"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/outline_settings_24"
                        app:iconGravity="textStart"
                        app:iconSize="20dp"
                        app:iconTint="@color/black" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <Button
                android:id="@+id/signOutBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:backgroundTint="@color/red"
                android:padding="15dp"
                android:text="Logout"
                android:textAllCaps="true"
                app:cornerRadius="10dp"
                app:icon="@drawable/outline_logout_24"
                app:iconGravity="textStart"
                app:iconSize="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>