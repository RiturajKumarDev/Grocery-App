<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ShivamKiranaStore" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/logo_blue</item>
        <item name="colorPrimaryVariant">@color/logo_dark_blue</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/logo_green</item>
        <item name="colorSecondaryVariant">@color/logo_dark_green</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color - Use direct color for testing -->
        <item name="android:statusBarColor">@color/logo_dark_blue</item>

        <!-- For API 21+ (Lollipop) -->
        <item name="android:windowLightStatusBar" >false</item>
        <!-- false = light status bar icons (for dark background) -->
        <!-- true = dark status bar icons (for light background) -->
    </style>

    <style name="Theme.ShivamKiranaStore" parent="Base.Theme.ShivamKiranaStore" />
</resources>