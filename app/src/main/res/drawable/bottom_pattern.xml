<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/logo_wheat"/>
            <corners android:topLeftRadius="30dp"
                android:topRightRadius="30dp"/>
        </shape>
    </item>

    <!-- Gold Border -->
    <item android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="4dp"
                android:color="@color/logo_gold"/>
            <solid android:color="@android:color/transparent"/>
            <corners android:topLeftRadius="28dp"
                android:topRightRadius="28dp"/>
        </shape>
    </item>

    <!-- Pattern: Dots -->
    <item android:top="20dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/logo_brown"
                android:dashWidth="10dp"
                android:dashGap="15dp"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
</layer-list>