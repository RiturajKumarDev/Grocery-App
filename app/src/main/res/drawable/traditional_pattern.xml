<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/logo_wheat"/>
        </shape>
    </item>

    <!-- Pattern Layer - Dots -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/logo_gold"/>
        </shape>
    </item>

    <!-- Traditional Border Design -->
    <item android:top="20dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/logo_brown"
                android:dashWidth="10dp"
                android:dashGap="8dp"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
</layer-list>