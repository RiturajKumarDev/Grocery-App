<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient Background -->
    <gradient
        android:angle="90"
        android:startColor="@color/logo_wheat"
        android:endColor="#FFF3E0"
        android:type="linear" />

    <!-- Rounded Corners -->
    <corners android:radius="20dp" />

    <!-- Border with dash effect for traditional look -->
    <stroke
        android:width="1dp"
        android:color="@color/logo_gold"
        android:dashWidth="4dp"
        android:dashGap="2dp" />
</shape>